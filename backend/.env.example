# Copy to .env and adjust as needed.

# Origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Satellite health diagnostics
# Path to the TorchScript DVM model. It is not committed to git (13 MB); by default the
# backend looks for app/ml/models/best_satellite_dvm_traced.pt. Relative paths resolve
# against the directory you start the server from.
# DVM_MODEL_PATH=/absolute/path/to/best_satellite_dvm_traced.pt
# Maximum accepted .npy upload size in bytes (default 16 MiB)
DIAGNOSTICS_MAX_UPLOAD_BYTES=16777216

# Mission operations (simulator <-> ground segment)
# SQLite file for telemetry, events, telecommands and downlink attempts (default: backend/data/mission.db)
# MISSION_DB_PATH=/absolute/path/to/mission.db
# Battery reserve used by the decision policy, the FDIR watchdog and the dashboard (percent)
BATTERY_RESERVE_PCT=30
# Telemetry older than this marks the spacecraft as out of contact (seconds)
TELEMETRY_STALE_S=15
